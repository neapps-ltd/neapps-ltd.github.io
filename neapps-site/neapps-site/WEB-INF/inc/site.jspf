static String esc(String s){
 if(s==null) return "";
 return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");
}
static String[] find(String id){
 for(String[] n: NOTICES) if(n[0].equals(id)) return n;
 return null;
}
